# 키 이름만. 실제 값은 분석 서버 /opt/honeypot/.env 와 각자 PC 의 .env 에만 둔다
# 이름은 2주차 인터페이스 회의에서 ②③④ 와 확정

# Supabase → Connect → Session pooler (포트 5432). EC2 가 IPv4 라 Direct 주소는 안 붙음
DATABASE_URL=postgresql://hp_writer.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
# 대시보드는 읽기 전용 계정
DASHBOARD_DATABASE_URL=postgresql://hp_reader.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require

RAW_DIR=/opt/honeypot/data/raw
GEOIP_DB=/opt/honeypot/data/GeoLite2-City.mmdb
ANTHROPIC_API_KEY=

# 수집 대상. 공인 IP 는 여기(.env)에만 적는다
SENSOR_SEOUL_HOST=
SENSOR_VIRGINIA_HOST=
SENSOR_SSH_PORT=62222
SENSOR_SSH_KEY=/home/ubuntu/.ssh/sensor_ro

S3_BUCKET=
